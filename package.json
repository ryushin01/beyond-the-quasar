{
  "name": "beyond-the-quasar",
  "version": "0.7.4",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p cypress/tsconfig.json",
    "lint": "oxlint src e2e && eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "story:dev": "histoire dev",
    "story:build": "histoire build",
    "build:site": "bun run build && HISTOIRE_BASE=/histoire/ bun run story:build && cp -R .histoire/dist dist/histoire",
    "data:tle": "node scripts/fetch-tle.mjs",
    "test:snapshot": "vitest run src/entities/satellite/model/snapshot.test.ts",
    "test:component": "cypress run --component",
    "size": "size-limit",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "@fontsource-variable/oswald": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@fontsource/gothic-a1": "^5.3.0",
    "@fontsource/nanum-gothic-coding": "^5.3.0",
    "@fontsource/orbit": "^5.3.0",
    "@quasar/extras": "^2.1.0",
    "@sentry/browser": "^11.12.0",
    "@tanstack/vue-query": "^5.106.1",
    "@unocss/preset-wind4": "^66.12.0",
    "@vueuse/core": "^15.0.0",
    "astronomy-engine": "^2.1.19",
    "d3-array": "^3.2.5",
    "d3-geo": "^3.1.2",
    "d3-scale": "^4.0.3",
    "d3-selection": "^3.0.1",
    "d3-shape": "^3.2.1",
    "d3-zoom": "^3.0.1",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "pinia": "^4.1.0",
    "quasar": "^2.35.2",
    "satellite.js": "6",
    "three": "0.187.0",
    "topojson-client": "^3.1.0",
    "unocss": "^66.12.0",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.18",
    "vue-router": "^5.4.0",
    "web-vitals": "^6.2.3",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@histoire/plugin-vue": "^1.0.0-beta.1",
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.0",
    "@quasar/vite-plugin": "1.12.0",
    "@size-limit/file": "^14.3.0",
    "@types/d3-array": "^3.2.2",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^26.6.6",
    "@types/three": "0.187.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "cypress": "15.21.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "histoire": "^1.0.0-beta.1",
    "jsdom": "^31.0.0",
    "oxlint": "^1.92.0",
    "sass-embedded": "^1.108.0",
    "size-limit": "^14.3.0",
    "typescript": "~5.9.3",
    "vite": "7.3.7",
    "vitest": "4",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "vite": "7.3.7"
  }
}
